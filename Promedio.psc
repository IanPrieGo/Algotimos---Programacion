Algoritmo promedio
	Definir c1, c2, c3, c4, s Como Entero
	Definir p Como Real
	Escribir 'Ingresa la calificacion 1'
	Leer c1
	Escribir 'Ingresa la calificacion 2'
	Leer c2
	Escribir 'Ingresa la calificacion 3'
	Leer c3
	Escribir 'Ingresa la calificacion 4'
	Leer c4
	s <- c1+c2+c3+c4
	p <- s/4
	Escribir 'El promedio es ', p
FinAlgoritmo
