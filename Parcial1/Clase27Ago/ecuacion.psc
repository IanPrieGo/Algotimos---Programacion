Algoritmo ecuacion
	
	Definir a, b Como Entero
	Definir x Como Real
	
	Imprimir "Ingresa el valor de a y b"
	Leer a, b
	
	Si a <> 0 Entonces
		x=-b/a
		Escribir "x = ", x
	Sino 
		Si b <> 0 Entonces
			Escribir "Solucion Imposible"
			
		Sino 
			Escribir "Solucion Indeterminada"
		FinSi
	FinSi
	
FinAlgoritmo
