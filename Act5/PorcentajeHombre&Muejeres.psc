Algoritmo  procentajeHombresMujeres
	Definir hombres, mujeres, total Como Entero
	Imprimir "Ingresa la cantidad de Hombres y luego de Muejeres en la clase"
	Leer  hombres, mujeres
	
	total = hombres + mujeres
	
	hombres = (100 * hombres)/ total
	mujeres = (100 * mujeres)/ total
	
	Imprimir "Porcentaje de Hombres: ", hombres, "%"
	Imprimir "Porcentaje de Mujeres: ", mujeres, "%"

	
	
FinAlgoritmo
